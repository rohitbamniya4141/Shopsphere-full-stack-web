{
  "name": "shopsphere",
  "version": "1.0.0",
  "description": "A full-stack e-commerce website for premium bags",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "npm install --prefix client && npm run build --prefix client",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "db:inspect": "node scripts/db-inspect.js",
    "seed:benchmark": "node scripts/benchmark-seed.js",
    "clear:benchmark": "node scripts/benchmark-clear.js",
    "benchmark": "node scripts/benchmark-run.js",
    "add:indexes": "node scripts/add-indexes.js",
    "data-quality": "node scripts/data-quality.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "config": "^4.4.1",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6"
  }
}
